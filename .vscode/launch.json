{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Browser",
            "request": "launch",
            "type": "editor-browser",
            "url": "http://127.0.0.1:8010/login",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Run Notes App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/python/notes0.py",
            "python": "${workspaceFolder}/venv/bin/python",
            "console": "integratedTerminal"
        }
    ]
}
