# Copy this file to .env for local development.
# Never commit real secrets.

# JWT signing key (used by auth.py)
AUTH_SECRET_KEY=replace-with-a-long-random-secret

# Cookie session signing key (used by SessionMiddleware)
SESSION_SECRET=replace-with-a-different-long-random-secret

# Notes storage path. Keep local for dev, set to mounted disk path in production.
NOTES_HOME=.notes/notes
